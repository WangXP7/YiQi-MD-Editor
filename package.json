{
  "name": "yiqi-md-editor-gpt56solxhigh",
  "version": "1.1.3",
  "description": "YiQi@MD-Editor-GPT5.6SolxHigh — a polished, offline-first Markdown editor for Windows.",
  "main": "electron/main.cjs",
  "author": "YiQi@MD-Editor-GPT5.6SolxHigh",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build:web": "vite build",
    "build:lite": "vite build && python compact/build.py",
    "build": "vite build && electron-builder --win nsis portable --x64",
    "build:portable": "vite build && electron-builder --win portable --x64",
    "preview": "vite preview --host 127.0.0.1",
    "start": "electron ."
  },
  "devDependencies": {
    "@codemirror/commands": "6.8.1",
    "@codemirror/lang-markdown": "6.3.3",
    "@codemirror/search": "6.5.10",
    "@codemirror/state": "6.5.2",
    "@codemirror/theme-one-dark": "6.1.2",
    "@codemirror/view": "6.36.5",
    "codemirror": "6.0.1",
    "dompurify": "3.2.6",
    "highlight.js": "11.11.1",
    "katex": "0.16.22",
    "lucide": "0.468.0",
    "markdown-it": "14.1.0",
    "markdown-it-anchor": "9.2.0",
    "markdown-it-attrs": "4.3.1",
    "markdown-it-container": "4.0.0",
    "markdown-it-deflist": "3.0.0",
    "markdown-it-emoji": "3.0.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-ins": "4.0.0",
    "markdown-it-mark": "4.0.0",
    "markdown-it-sub": "2.0.0",
    "markdown-it-sup": "2.0.0",
    "markdown-it-task-lists": "2.1.1",
    "markdown-it-texmath": "1.0.0",
    "mermaid": "11.6.0",
    "concurrently": "9.1.2",
    "electron": "35.1.5",
    "electron-builder": "26.0.12",
    "vite": "6.2.5",
    "wait-on": "8.0.3"
  },
  "build": {
    "appId": "com.yiqi.mdeditor.gpt56solxhigh",
    "productName": "YiQi@MD-Editor-GPT5.6SolxHigh-v1.1.3",
    "copyright": "Copyright © 2026 YiQi@MD-Editor-GPT5.6SolxHigh",
    "asar": true,
    "electronLanguages": ["zh-CN", "en-US"],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "artifactName": "YiQi@MD-Editor-GPT5.6SolxHigh-v${version}-Setup-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YiQi@MD-Editor-GPT5.6SolxHigh-v1.1.3",
      "installerLanguages": ["zh_CN", "en_US"],
      "language": "2052",
      "perMachine": false
    },
    "portable": {
      "artifactName": "YiQi@MD-Editor-GPT5.6SolxHigh-v${version}-Portable-${arch}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown Document",
        "description": "Markdown 文档",
        "role": "Editor"
      }
    ]
  }
}
