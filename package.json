{
  "name": "yiqi-md-editor-wb-dsv4-flash",
  "version": "1.1.0",
  "description": "墨览 YiQi@MD-Editor-wb-DSv4-Flash 1.1.0 - 美观、全格式支持的 Windows Markdown 查看/编辑桌面应用（多标签 + 大纲栏 + 悬浮复制）",
  "main": "src/main.js",
  "author": "MarkNote Team",
  "license": "MIT",
  "productName": "墨览 YiQi@MD-Editor-wb-DSv4-Flash 1.1.0",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.mjs",
    "start": "npm run build:renderer && electron .",
    "dist:win": "npm run build:renderer && electron-builder --win",
    "pack:win": "npm run build:renderer && electron-builder --win --dir",
    "dist:portable": "npm run build:renderer && electron-builder --win portable",
    "dist:nsis": "npm run build:renderer && electron-builder --win nsis"
  },
  "dependencies": {
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.2",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.28.4",
    "@lezer/highlight": "^1.2.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.24.2",
    "highlight.js": "^11.10.0",
    "katex": "^0.16.11",
    "markdown-it": "^14.1.0",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^10.9.1"
  },
  "build": {
    "appId": "com.marknote.editor",
    "productName": "墨览 YiQi@MD-Editor-wb-DSv4-Flash 1.1.0",
    "asar": true,
    "directories": {
      "output": "build"
    },
    "icon": "resources/icon.ico",
    "files": [
      "src/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "墨览 YiQi@MD-Editor-wb-DSv4-Flash 1.1.0"
    },
    "portable": {
      "artifactName": "${productName}-portable-${arch}.${ext}"
    }
  }
}
