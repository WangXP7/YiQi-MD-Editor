classDiagram
    %% 本次增量涉及的共享契约与渲染层关系（仅展示变化点）

    class IPC {
        +openByPath: 'file:openByPath'
        +setTitle: 'win:setTitle'
    }

    class MenuAction {
        <<union>>
        +'toggleFocus'
        +'toggleTypewriter'
        +'copyHtml'
        +'openRecent:' + string
        +'theme:' + string
        +（原 new/open/save/... 保留）
    }

    class ElectronAPI {
        +openByPath(path): Promise~OpenFileResult | {error:'not_found'}~
        +setTitle(title): Promise~void~
        +（原 openFile/saveFile/.../onMenuAction 保留）
    }

    class ThemeName {
        <<union>>
        +'light' | 'dark' | 'paper' | 'graphite' | 'midnight'
    }

    class Constants {
        +APP_NAME: string
        +APP_VERSION: string
        +THEME_LIST: {key:ThemeName, label:string}[]
    }

    class AppState {
        +theme: ThemeName
        +setTheme(name): void
        +focusMode: boolean
        +typewriterMode: boolean
        +toggleFocusMode(): void
        +toggleTypewriterMode(): void
        +（原 content/filePath/recents/... 保留）
    }

    class App {
        +handleMenuAction(action)
        +handleDrop(e)
        +openByPath(path)
        +updateWinTitle()
    }

    class EditorPane {
        +extensions: closeBrackets()+closeBracketsKeymap
        +focus-mode 类名
        +typewriter 滚动补偿(updateListener)
    }

    class StatusBar {
        +focus/typewriter 指示
    }

    class TopBar {
        +显示当前主题名 + 图标
    }

    class AboutDialog {
        +明暗兼容模态框
    }

    MenuAction ..> Constants : theme: 前缀取值来自 THEME_LIST.key
    ElectronAPI ..> IPC : invoke 通道
    AppState ..> ThemeName : theme 类型
    Constants ..> ThemeName : THEME_LIST.key
    App ..> AppState : 提供/消费
    App ..> EditorPane : focusMode/typewriterMode
    App ..> StatusBar : 模式指示
    App ..> TopBar : 当前主题
    App ..> AboutDialog : aboutOpen 渲染
    App ..> ElectronAPI : openByPath/setTitle/onMenuAction
