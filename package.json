{
  "name": "yiqi-md-editor",
  "version": "1.0.0",
  "description": "YiQi@MD-Editor-千问-GLM5.2 — 一款美观、功能齐全的 Markdown 查看/编辑器",
  "main": "src/main.js",
  "author": "WangXP7",
  "license": "MIT",
  "productName": "YiQi@MD-Editor-千问-GLM5.2",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-deflist": "^3.0.0",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-ins": "^4.0.0",
    "codemirror": "^5.65.16",
    "katex": "^0.16.9",
    "mermaid": "^10.9.0",
    "highlight.js": "^11.9.0",
    "github-markdown-css": "^5.5.1"
  },
  "build": {
    "appId": "com.wangxp7.yiqi.mdeditor",
    "productName": "YiQi@MD-Editor-千问-GLM5.2",
    "copyright": "Copyright © 2026 WangXP7 — YiQi@MD-Editor-千问-GLM5.2",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "YiQi@MD-Editor-千问-GLM5.2-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "YiQi@MD-Editor-千问-GLM5.2-${version}-Setup.${ext}",
      "shortcutName": "YiQi@MD-Editor-千问-GLM5.2",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "YiQi@MD-Editor-千问-GLM5.2-${version}-Portable.${ext}"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "build/**/*",
      "node_modules/**/*",
      "package.json"
    ]
  }
}
